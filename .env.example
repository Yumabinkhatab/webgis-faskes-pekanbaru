# Salin file ini menjadi .env lalu isi dengan connection string MongoDB Atlas Anda
# Contoh: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB_NAME=sig_faskes_pekanbaru
PORT=3000
